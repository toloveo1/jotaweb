<div class="top-row ps-3 navbar navbar-dark bg-dark shadow-sm">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold tracking-wide" href="">Jotaweb</a>
        <button title="Menú de navegación" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable bg-dark" @onclick="ToggleNavMenu">
    <nav class="flex-column p-2">
        <div class="nav-item px-2 mb-1">
            <NavLink class="nav-link rounded px-3" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door me-2" aria-hidden="true"></i> Inicio
            </NavLink>
        </div>
        <div class="nav-item px-2 mb-1">
            <NavLink class="nav-link rounded px-3" href="quienessomos">
                <i class="bi bi-person me-2" aria-hidden="true"></i> Quién soy
            </NavLink>
        </div>
        <div class="nav-item px-2 mb-1">
            <NavLink class="nav-link rounded px-3" href="proyectos">
                <i class="bi bi-code-slash me-2" aria-hidden="true"></i> Proyectos
            </NavLink>
        </div>
        <div class="nav-item px-2 mb-1">
            <NavLink class="nav-link rounded px-3" href="contacto">
                <i class="bi bi-envelope me-2" aria-hidden="true"></i> Contacto
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
