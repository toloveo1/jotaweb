@page "/contacto"
@using System.ComponentModel.DataAnnotations

<PageTitle>Contacto - Jotaweb</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            
            <div class="card shadow-sm border-0 mb-5">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-primary">Contacto</h2>
                        <p class="text-muted">Por favor, rellena el formulario y salúdame</p>
                    </div>

                    <EditForm Model="@contacto" OnValidSubmit="ProcesarFormulario">
                        <DataAnnotationsValidator />

                        <div class="form-floating mb-3">
                            <InputText id="nombre" class="form-control" @bind-Value="contacto.Nombre" placeholder="Tu nombre" />
                            <label for="nombre">Nombre</label>
                            <ValidationMessage For="@(() => contacto.Nombre)" class="text-danger small mt-1" />
                        </div>

                        <div class="form-floating mb-3">
                            <InputText id="email" type="email" class="form-control" @bind-Value="contacto.Email" placeholder="Tu email" />
                            <label for="email">Email</label>
                            <ValidationMessage For="@(() => contacto.Email)" class="text-danger small mt-1" />
                        </div>

                        <div class="form-floating mb-4">
                            <InputTextArea id="mensaje" class="form-control" @bind-Value="contacto.Mensaje" placeholder="Tu mensaje" style="height: 120px" />
                            <label for="mensaje">Mensaje</label>
                            <ValidationMessage For="@(() => contacto.Mensaje)" class="text-danger small mt-1" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill fw-bold transition-hover">
                            <i class="bi bi-send me-2"></i> Enviar Mensaje
                        </button>
                    </EditForm>

                    @if (mensajeEnviado)
                    {
                        <div class="alert alert-success mt-4 mb-0 d-flex align-items-center" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <div>¡Gracias, he recibido tu mensaje!</div>
                        </div>
                    }
                </div>
            </div>

            <div class="text-center">
                <h5 class="fw-light mb-4">Si lo prefieres, también puedes encontrarme en:</h5>
                <div class="d-flex justify-content-center gap-3">
                    <a href="https://www.linkedin.com/in/jconk/" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary rounded-circle p-3 lh-1 shadow-sm transition-hover">
                        <i class="bi bi-linkedin" style="font-size: 1.5rem;"></i>
                    </a>
                    <a href="https://github.com/toloveo1" target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark rounded-circle p-3 lh-1 shadow-sm transition-hover">
                        <i class="bi bi-github" style="font-size: 1.5rem;"></i>
                    </a>
                    <a href="https://medium.com/@@jorgeconca" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary rounded-circle p-3 lh-1 shadow-sm transition-hover">
                        <i class="bi bi-medium" style="font-size: 1.5rem;"></i>
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private ContactoModel contacto = new();
    private bool mensajeEnviado = false;

    private void ProcesarFormulario()
    {
        // En Blazor WebAssembly, las claves de APIs de correo (como SendGrid) 
        // quedarían expuestas si se envían desde aquí. La lógica real de envío 
        // deberá delegarse a un backend o servicio de terceros en el futuro.
        mensajeEnviado = true;
    }

    public class ContactoModel
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        public string? Nombre { get; set; }

        [Required(ErrorMessage = "El email es obligatorio.")]
        [EmailAddress(ErrorMessage = "El email no tiene un formato válido.")]
        public string? Email { get; set; }

        [Required(ErrorMessage = "El mensaje es obligatorio.")]
        public string? Mensaje { get; set; }
    }
}
