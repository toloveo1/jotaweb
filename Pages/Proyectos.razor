@page "/proyectos"

<PageTitle>Proyectos - Jotaweb</PageTitle>

<div class="container mt-4 mb-5">
    <div class="text-center mb-5">
        <h2 class="text-primary fw-bold">Mis Proyectos</h2>
        <p class="text-muted">Una selección de mis trabajos y desarrollos recientes en .NET, Blazor y tecnologías web.</p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var proyecto in listaProyectos)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    @if (!string.IsNullOrEmpty(proyecto.ImagenUrl))
                    {
                        <img src="@proyecto.ImagenUrl" class="card-img-top" alt="@proyecto.Titulo" style="height: 200px; object-fit: cover;" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold text-dark">@proyecto.Titulo</h5>
                        <p class="card-text text-secondary flex-grow-1">@proyecto.Descripcion</p>
                        
                        <div class="mb-3">
                            @foreach (var tech in proyecto.Tecnologias)
                            {
                                <span class="badge bg-secondary me-1 mb-1">@tech</span>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            @if (!string.IsNullOrEmpty(proyecto.EnlaceGitHub))
                            {
                                <a href="@proyecto.EnlaceGitHub" target="_blank" class="btn btn-outline-dark btn-sm rounded-pill">
                                    <i class="bi bi-github me-1"></i> GitHub
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(proyecto.EnlaceDemo))
                            {
                                <a href="@proyecto.EnlaceDemo" target="_blank" class="btn btn-primary btn-sm rounded-pill">
                                    <i class="bi bi-globe me-1"></i> Demo
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<ProyectoModel> listaProyectos = new()
    {
        new ProyectoModel
        {
            Titulo = "Jotaweb Personal Portfolio",
            Descripcion = "Página web personal y portafolio interactivo desarrollado desde cero utilizando Blazor WebAssembly y Bootstrap 5.",
            Tecnologias = new List<string> { "C#", "Blazor WebAssembly", ".NET 8", "Bootstrap 5" },
            EnlaceGitHub = "https://github.com/toloveo1",
            ImagenUrl = "bienvenida.jpg"
        },
        new ProyectoModel
        {
            Titulo = "Gestor de Tareas .NET",
            Descripcion = "Aplicación de gestión de tareas con operaciones CRUD completas, validación de formularios y persistencia local.",
            Tecnologias = new List<string> { "C#", ".NET", "Entity Framework", "Blazor" },
            EnlaceGitHub = "https://github.com/toloveo1",
            ImagenUrl = ""
        },
        new ProyectoModel
        {
            Titulo = "API RESTful de Servicios",
            Descripcion = "Servicio backend desarrollado en ASP.NET Core Web API con autenticación JWT y documentación Swagger.",
            Tecnologias = new List<string> { "C#", "ASP.NET Core", "SQL Server", "JWT" },
            EnlaceGitHub = "https://github.com/toloveo1",
            ImagenUrl = ""
        }
    };

    public class ProyectoModel
    {
        public string Titulo { get; set; } = string.Empty;
        public string Descripcion { get; set; } = string.Empty;
        public List<string> Tecnologias { get; set; } = new();
        public string? EnlaceGitHub { get; set; }
        public string? EnlaceDemo { get; set; }
        public string? ImagenUrl { get; set; }
    }
}
